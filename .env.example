# Neon (or any Postgres) connection string
DATABASE_URL=postgres://user:password@host/dbname?sslmode=require

# Random long string used to sign instructor sessions and QR tokens.
# Generate one with: openssl rand -base64 32
AUTH_SECRET=

# Public URL of the deployed app (used to build the /attend/<token> link
# embedded in the QR code). Set this to your Vercel URL in production.
APP_URL=http://localhost:3000
